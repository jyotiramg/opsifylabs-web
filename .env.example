# Contact form (serverless function /api/contact) — set these in
# Vercel → Project → Settings → Environment Variables, then redeploy.
GMAIL_USER=opsifylabs@gmail.com
# Google "App password" (16 characters) for GMAIL_USER, NOT the normal password.
GMAIL_APP_PASSWORD=
# Optional: where enquiries are delivered (default opsifylabs@gmail.com)
CONTACT_TO=opsifylabs@gmail.com

# Optional: override the form's endpoint (defaults to /api/contact)
VITE_CONTACT_ENDPOINT=
